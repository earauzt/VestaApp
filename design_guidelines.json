      "dashboard_bg": "https://images.unsplash.com/photo-1615852993296-b42d4dbb5555?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjAzMjV8MHwxfHNlYXJjaHwyfHxtb2Rlcm4lMjBtaW5pbWFsaXN0JTIwaG9tZSUyMG9mZmljZSUyMGRlc2slMjBmaW5hbmNlfGVufDB8fHx8MTc2OTM2MzA3N3ww&ixlib=rb-4.1.0&q=85",
      "family_moment": "https://images.unsplash.com/photo-1721042235332-45f89689cfba?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjAzMjh8MHwxfHNlYXJjaHwzfHxoYXBweSUyMGZhbWlseSUyMGZpbmFuY2lhbCUyMGZyZWVkb218ZW58MHx8fHwxNzY5MzYzMDgwfDA&ixlib=rb-4.1.0&q=85"
    }
  },
  "universal_guidelines": [
    "Avoid 'AI Slop': No generic gradients, no centered text blocks.",
    "Use 'Manrope' for all financial data/numbers.",
    "Primary Color (Forest Green) is for Growth/Money. Use Terracotta for Alerts.",
    "Dashboard Grid: Use 'Bento' style. Mix 1x1, 2x1, and 2x2 blocks.",
    "Glassmorphism: Use for sticky headers and floating action buttons.",
    "Data-TestID: All interactive elements must have data-testid attribute.",
    "Charts: Use Recharts with custom tooltips (no default browser tooltips).",
    "Forms: Use Shadcn Form + Zod for validation. No raw inputs."
  ],
  "instructions_to_main_agent": "1. Install fonts in index.css. 2. Update tailwind.config.js with the color palette. 3. Create a 'Layout' component that handles the sidebar/header structure. 4. Build the Dashboard using the Bento Grid strategy. 5. Implement the 'Login' page with the 'Tetris' grid and the family image."
}